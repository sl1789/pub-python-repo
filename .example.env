# backend
DATABASE_URL=sqlite:///./app.db
API_HOST=127.0.0.1
API_PORT=8000
API_BASE=http://127.0.0.1:8000
APP_AUTO_CREATE_TABLES=true

# Databricks (required to submit Monte Carlo jobs)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=

# Azure ADLS Gen2 (Monte Carlo parquet export)
AZURE_STORAGE_ACCOUNT=
AZURE_RESULTS_CONTAINER=results
# Top-level prefix under the container. Datasets live one level below:
#     <container>/<prefix>/<dataset>/[ticker=<TICKER>/]*.parquet
#
# Datasets written by the Databricks notebooks:
#   simulations        -> monte_carlo_simulation.ipynb (per-job; read via /results?job_id=)
#   mc_vs_actual       -> mc_vs_actual_test.ipynb (research; read via /datasets/...)
#   emc_diagnostics    -> mc_vs_actual_test.ipynb (research)
#   block_length_sweep -> mc_vs_actual_test.ipynb (research)
#   lam_sweep          -> mc_vs_actual_test.ipynb (research)
#
# Only the `mc_vs_actual_*` research datasets are exposed via the
# /datasets API; `simulations` is reached via /results?job_id=<id>.
AZURE_RESULTS_PREFIX=export
AZURE_STORAGE_KEY=<storage_account_key>

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Demo user
DEMO_USER_USERNAME=demo
DEMO_USER_PASSWORD=demo123
DEMO_USER_ROLES=viewer,submitter

# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit the real .env.
# Anything left blank disables that integration gracefully.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=prod
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# --- Demo user (seeded on first start) ---
DEMO_USER_USERNAME=demo
DEMO_USER_PASSWORD=change-me
DEMO_USER_ROLES=viewer,operator

# --- Database (default is the on-volume SQLite, leave as-is for the demo) ---
# DATABASE_URL=sqlite:////data/app.db

# --- Azure ADLS Gen2 (parquet results) ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_RESULTS_CONTAINER=results
AZURE_RESULTS_PREFIX=export

# --- Databricks (job runner) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=
